{
  "_note": "Single source for the Dead Reckoning design tokens. 'existing' means the game already defines it under this name; 'new' means proposed, not yet in the game. Edit here, run python3 tools/tokens.py.",
  "color": {
    "desk":    {"light": "#ebdfc2", "dark": "#0b1a40", "role": "Top and bottom bars, page background", "existing": true},
    "desk-2":  {"light": "#d9c9a2", "dark": "#10245a", "role": "Bar edge, deeper parchment", "existing": true},
    "paper":   {"light": "#f6eed9", "dark": "#132a63", "role": "Panels, cards, buttons at rest", "existing": true},
    "paper-2": {"light": "#ece2c8", "dark": "#0f2252", "role": "Hover, wells, progress tracks", "existing": true},
    "ink":     {"light": "#2e2519", "dark": "#eadfb4", "role": "Text, outlines, pressed fill", "existing": true},
    "ink-soft":{"light": "#7b6a55", "dark": "#a9a283", "role": "Secondary text, labels", "existing": true},
    "rule":    {"light": "#cbbd98", "dark": "#2d4688", "role": "Dividers, quiet borders", "existing": true},
    "sea":     {"light": "#4a6a8a", "dark": "#8aa8d6", "role": "Water, wind and current data", "existing": true},
    "brass":   {"light": "#b8862a", "dark": "#d9a940", "role": "Focus ring, instruments, caution, reward", "existing": true},
    "ochre":   {"light": "#b2452c", "dark": "#e4905f", "role": "Warning, danger, destination, north mark", "existing": true},
    "pencil":  {"light": "#4a5a8a", "dark": "#9db2e2", "role": "Plotted lines, bearings, selection", "existing": true},
    "good":    {"light": "#3f7a4a", "dark": "#7fb283", "role": "Healthy, fair trim, profit", "existing": false},
    "chart-ink":{"light": "#3a2614", "dark": "#3a2614", "role": "Ink on the 17th-century chart (stays brown in both themes)", "existing": false}
  },
  "font": {
    "f-display": {"stack": "\"IM Fell English SC\",\"IM Fell English\",Georgia,serif", "role": "Titles, port names, panel headings", "existing": true},
    "f-italic":  {"stack": "\"IM Fell English\",Georgia,serif", "role": "Voyage line, flavour text", "existing": true},
    "f-body":    {"stack": "\"Spectral\",Georgia,\"Times New Roman\",serif", "role": "Reading text, lists", "existing": true},
    "f-data":    {"stack": "\"IBM Plex Mono\",ui-monospace,Menlo,monospace", "role": "Numbers, buttons, small caps labels", "existing": true}
  },
  "type-scale": {
    "fs-micro": {"px": 10.5, "role": "Small-caps labels, units (uppercase, .08em)", "merges": "10, 10.5, 11"},
    "fs-small": {"px": 12,   "role": "Buttons, table rows, hints", "merges": "11.5, 12, 12.5"},
    "fs-body":  {"px": 13,   "role": "Default text, form rows", "merges": "13, 14"},
    "fs-lead":  {"px": 15,   "role": "Voyage line, emphasis", "merges": "15, 16"},
    "fs-head":  {"px": 17,   "role": "Panel and dock headings", "merges": "17, 18"},
    "fs-brand": {"px": 22,   "role": "Title bar brand, card titles", "merges": "22, 26"}
  },
  "radius": {"r-1": 2, "r-2": 3, "r-3": 6, "r-4": 12},
  "space":  {"sp-1": 2, "sp-2": 4, "sp-3": 6, "sp-4": 8, "sp-5": 12, "sp-6": 16, "sp-7": 24},
  "stroke": {"line": 1, "line-heavy": 2, "icon": 1.6, "icon-tab": 1.7, "icon-fine": 1},
  "icon":   {"icon-s": 18, "icon-m": 22, "icon-l": 26, "tool-btn": 40, "tool-gap": 24},
  "elevation": {
    "shadow-dock":  "0 8px 28px rgba(20,14,10,.35)",
    "shadow-float": "0 4px 14px rgba(20,14,10,.25)",
    "shadow-card":  "0 20px 60px rgba(0,0,0,.5)",
    "glass":        "rgba(246,238,217,.93)"
  },
  "layer": {"z-hud": 3, "z-dock": 16, "z-menu": 40, "z-popover": 60, "z-sheet": 70, "z-modal": 91}
}
